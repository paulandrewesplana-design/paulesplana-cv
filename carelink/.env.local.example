# CareLink — Firebase configuration
# Copy to `.env.local` and fill with your Firebase project's web-app config.
# When these are absent, the app runs against seeded in-memory mock data,
# so the dashboards render without a live backend.
#
# HIPAA note: these are public web-client keys (safe to expose to the browser).
# Server-side Admin credentials and Firestore Security Rules — NOT these keys —
# are what actually protect PHI. Never place service-account secrets here.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: mapping provider token for the live-tracking view.
NEXT_PUBLIC_MAPBOX_TOKEN=
